# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.Python

# --- Virtual environments ---
venv/
.venv/
env/

# --- Environment / secrets ---
.env
*.pem
*.key

# --- Database ---
*.db
*.db-wal
*.db-shm
*.sqlite3

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Uploaded files (runtime data, not source) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
*.swp

# --- Alembic (keep the migrations themselves, ignore local sqlite artifacts) ---
*.sqlite

# --- Streamlit ---
.streamlit/secrets.toml

# --- Logs ---
*.log
