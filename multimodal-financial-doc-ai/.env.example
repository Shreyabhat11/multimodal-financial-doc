# ============================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# ============================================================

# --- Application ---
APP_ENV=development                  # development | staging | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Vision-Language Model ---
# Provider selects which BaseVisionModel implementation is instantiated.
# qwen-vl        -> local transformers inference (needs GPU, see README hardware section)
# llava          -> local transformers inference (needs GPU)
# hf-inference   -> Hugging Face Inference API (no local GPU required)
MODEL_PROVIDER=hf-inference
MODEL_NAME=Qwen/Qwen2-VL-7B-Instruct
HF_TOKEN=                            # required for hf-inference and for gated model downloads
MODEL_DEVICE=cuda                    # cuda | cpu | mps (ignored for hf-inference)
MODEL_LOAD_IN_4BIT=true              # bitsandbytes 4-bit quantization for local inference
MODEL_MAX_NEW_TOKENS=2048

# --- OCR fallback ---
OCR_ENABLED=true
OCR_ENGINE=tesseract
TESSERACT_CMD=/usr/bin/tesseract

# --- Document processing limits ---
MAX_FILE_SIZE_MB=25
MAX_PAGES=50
PAGE_RENDER_DPI=200
VLM_REQUEST_TIMEOUT_SECONDS=90
VLM_MAX_RETRIES=3

# --- Confidence / validation thresholds ---
CONFIDENCE_THRESHOLD=0.75            # below this -> OCR fallback / human review
BALANCE_TOLERANCE=0.01               # currency units allowed as rounding slack
HUMAN_REVIEW_ON_VALIDATION_FAILURE=true

# --- Database ---
DATABASE_URL=postgresql+psycopg2://findoc_user:findoc_pass@localhost:5432/findoc_db
DATABASE_ECHO=false

# --- CrewAI / LLM used by agents for reasoning (NOT for arithmetic) ---
AGENT_LLM_PROVIDER=anthropic         # anthropic | openai | ollama
AGENT_LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CREWAI_DISABLE_TELEMETRY=true        # avoids network calls to CrewAI's telemetry endpoint in offline/sandboxed environments

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:8501

# --- Streamlit ---
STREAMLIT_API_BASE_URL=http://localhost:8000
